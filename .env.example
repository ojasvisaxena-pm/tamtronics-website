# Copy to .env for local development. Never commit .env or put real secrets in this file.
#
# On AWS Amplify these are NOT set here:
#   - Secrets (MONGODB_URI, PAYLOAD_SECRET, SMTP_USER, SMTP_PASS) live in AWS Secrets Manager
#     (secret id in the Amplify variable APP_SECRET_ID) and are written to .env.production at build.
#   - Everything else is an Amplify environment variable. See docs/DEPLOYMENT.md > AWS Amplify.
# Nothing secret may use the NEXT_PUBLIC_ prefix: those values are compiled into browser code.

# --- Secrets (Secrets Manager on Amplify) -------------------------------------------------
# MongoDB connection string (Atlas or self-hosted), including the database name. Server-side only.
MONGODB_URI=mongodb://127.0.0.1:27017/tamtronics
# Long random value: openssl rand -hex 32. Changing it logs every admin out.
PAYLOAD_SECRET=
# SMTP login, if email is set up.
# SMTP_USER=
# SMTP_PASS=

# --- Non-sensitive settings (Amplify environment variables) --------------------------------
# Where this deployment is served from, no trailing slash. Used for admin CORS/CSRF. Baked in at build.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Media storage. Set S3_MEDIA_BUCKET to store CMS uploads in S3 (required on Amplify, which has no
# persistent disk). Locally, leave it unset to use MEDIA_DIR; with it set, your AWS profile is used.
# S3_MEDIA_BUCKET=
# S3_MEDIA_REGION=us-east-1
# MEDIA_DIR=/data/media

# SMTP for all site email: password resets and Business Inquiry Form notifications.
# Without SMTP_HOST nothing is sent; reset emails are only printed to the server log, and
# form submissions are still saved, marked "Not sent (email not set up)".
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false            # true for port 465 (SSL); false for 587 (STARTTLS)
# EMAIL_FROM_ADDRESS=no-reply@example.com
# EMAIL_FROM_NAME=Tamtronics
# Who receives new inquiries when Forms > Business Inquiry Form lists no recipients. Comma-separated.
# INQUIRY_RECEIVER_EMAIL=sales@example.com

# --- Amplify only ---------------------------------------------------------------------------
# Secrets Manager secret id read by scripts/amplify-env.mjs during the Amplify build.
# APP_SECRET_ID=tamtronics/staging/app
