{
  "name": "tamtronics-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tamtronics website: Next.js + Payload CMS + MongoDB",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "extract:diagrams": "tsx scripts/extract-diagrams.ts",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.92.1",
    "@payloadcms/email-nodemailer": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/plugin-redirects": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/storage-s3": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "cross-env": "10.1.0",
    "graphql": "16.14.2",
    "mongodb": "6.20.0",
    "next": "16.4.3",
    "payload": "3.92.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "dotenv": "16.4.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
